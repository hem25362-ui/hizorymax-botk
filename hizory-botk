# ======== ОТПРАВКА EMAIL ========

def send_email(reason_title: str, body: str):
    try:
        msg = MIMEText(body, "plain", "utf-8")
        msg["Subject"] = Header(f"Жалоба: {reason_title}", "utf-8")
        msg["From"]    = MY_EMAIL
        msg["To"]      = TARGET_EMAIL
        server = smtplib.SMTP("smtp.gmail.com", 587)
        server.starttls()
        server.login(MY_EMAIL, APP_PASSWORD)
        server.sendmail(MY_EMAIL, [TARGET_EMAIL], msg.as_string())
        server.quit()
        return True, None
    except smtplib.SMTPAuthenticationError:
        return False, "Ошибка авторизации Gmail. Проверьте app password."
    except Exception as e:
        return False, str(e)


# ======== ЗАПУСК ========

def main():
    print("🤖 HIZORYMAX бот запущен...")
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    # Основной диалог
    main_conv = ConversationHandler(
        entry_points=[CommandHandler("start", start)],
        states={
            CHOOSE_REASON: [CallbackQueryHandler(choose_reason, pattern="^(porn|drugs|data)$")],
            ENTER_LINK:    [MessageHandler(filters.TEXT & ~filters.COMMAND, enter_link)],
            CONFIRM:       [CallbackQueryHandler(confirm_send, pattern="^(send|cancel)$")],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
    )

    # Админ-панель
    admin_conv = ConversationHandler(
        entry_points=[CommandHandler("admin", admin_panel)],
        states={
            ADMIN_MENU: [
                CallbackQueryHandler(admin_callback, pattern="^adm_"),
            ],
            ADMIN_GIVE_WAIT_ID: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, admin_give_wait_id),
                CallbackQueryHandler(admin_callback, pattern="^adm_back$"),
            ],
            ADMIN_GIVE_WAIT_PLAN: [
                CallbackQueryHandler(admin_give_wait_plan, pattern="^(adm_plan_|adm_back)"),
            ],
            ADMIN_REVOKE_WAIT_ID: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, admin_revoke_wait_id),
                CallbackQueryHandler(admin_callback, pattern="^adm_back$"),
            ],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
    )

    app.add_handler(main_conv)
    app.add_handler(admin_conv)
    app.add_handler(CallbackQueryHandler(buy_plan, pattern="^buy_"))
    app.run_polling()


if __name__ == "__main__":
    main()
