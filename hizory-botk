# ======== ПОДПИСКИ ========

def load_subs() -> dict:
    if os.path.exists(SUBS_FILE):
        with open(SUBS_FILE, "r") as f:
            return json.load(f)
    return {}

def save_subs(subs: dict):
    with open(SUBS_FILE, "w") as f:
        json.dump(subs, f, indent=2)

def has_active_sub(user_id: int) -> bool:
    if user_id == OWNER_ID:
        return True
    subs = load_subs()
    entry = subs.get(str(user_id))
    if not entry:
        return False
    if entry["until"] == "forever":
        return True
    return datetime.now() < datetime.fromisoformat(entry["until"])

def grant_sub(user_id: int, plan_key: str):
    subs = load_subs()
    plan = PLANS[plan_key]
    until = "forever" if plan["days"] == -1 else (
        datetime.now() + timedelta(days=plan["days"])
    ).isoformat()
    subs[str(user_id)] = {"plan": plan_key, "until": until}
    save_subs(subs)

def revoke_sub(user_id: int):
    subs = load_subs()
    subs.pop(str(user_id), None)
    save_subs(subs)

def sub_info(user_id: int) -> str:
    if user_id == OWNER_ID:
        return "👑 Владелец — доступ навсегда"
    subs = load_subs()
    entry = subs.get(str(user_id))
    if not entry:
        return "❌ Подписки нет"
    if entry["until"] == "forever":
        return f"✅ Активна · тариф: {PLANS[entry['plan']]['label']} · навсегда"
    until = datetime.fromisoformat(entry["until"])
    if datetime.now() >= until:
        return "⏰ Подписка истекла"
    left  = until - datetime.now()
    days  = left.days
    hours = left.seconds // 3600
    return f"✅ Активна · осталось {days}д {hours}ч · тариф: {PLANS[entry['plan']]['label']}"

def subs_count() -> int:
    subs = load_subs()
    count = 0
    for entry in subs.values():
        if entry["until"] == "forever" or datetime.now() < datetime.fromisoformat(entry["until"]):
            count += 1
    return count


